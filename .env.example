# Copy to .env; never commit the real file.
POSTGRES_DB=loadpilot
POSTGRES_USER=loadpilot
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
PLATFORM_USER=admin
PLATFORM_PASSWORD=replace-with-a-long-random-login-password
# Reserved for a later AI adapter; no provider requests exist in the scaffold.
AI_PROVIDER=none
OPENAI_API_KEY=
AI_MODEL=
# Production only: immutable GHCR images from a successful CI build.
PLATFORM_IMAGE=ghcr.io/your-owner/your-repo-platform:sha-COMMIT
WEB_IMAGE=ghcr.io/your-owner/your-repo-web:sha-COMMIT
