# Development template. Copy to .env and replace placeholder passwords.
# Export values in your backend terminal/IDE; Spring Boot does not load .env.
# The native systemd service reads /etc/loadpilot/platform.env instead.

# Application database
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/loadpilot
POSTGRES_USER=loadpilot
POSTGRES_PASSWORD=replace-with-your-database-password

# One-time first account seed, only when the database account table is empty.
# 8-72 UTF-8 bytes. Passwords are BCrypt-hashed; later starts use stored accounts.
# Remove PLATFORM_PASSWORD after initial provisioning; it never resets a saved password.
PLATFORM_USER=admin
PLATFORM_PASSWORD=replace-with-your-platform-password
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m

# Connection credentials stay on the backend. Supply a Base64-encoded random
# 32-byte key; preserve it separately from database backups. Empty disables setup.
CONNECTION_MASTER_KEY=
# Comma-separated exact origins and literal resolved IPs for authorized lab services.
# Empty lists deny outbound inspection. Kubernetes/Prometheus require HTTPS.
CONNECTION_ALLOWED_ORIGINS=
CONNECTION_ALLOWED_ADDRESSES=

# Reserved for a later AI adapter; no provider requests exist in the scaffold.
AI_PROVIDER=none
OPENAI_API_KEY=
AI_MODEL=
